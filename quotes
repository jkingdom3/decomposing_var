%%% RUMSFELD QUOTE
\begin{quote}
"[T]here are known knowns; there are things we know we know.
We also know there are known unknowns; that is to say we know there are some things we do not know. But there are also unknown unknowns – there are things we do not know we don't know."
\textbf{- Donald Rumsfeld (2002) \footnote{United States Secretary of Defence, February 2002 press briefing (source: \url{http://en.wikipedia.org/wiki/There_are_known_knowns)}}}.
\end{quote}